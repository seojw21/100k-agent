# Anthropic (Claude API)
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# PayPal
# Get credentials: https://developer.paypal.com → My Apps & Credentials
# Create an app → copy Client ID and Secret
# For sandbox (testing): use sandbox credentials
# For live (real money): change PAYPAL_MODE to "live" and use live credentials
PAYPAL_CLIENT_ID=AY...
PAYPAL_CLIENT_SECRET=EH...
PAYPAL_MODE=sandbox

# Your deployed URL (no trailing slash)
# Local: http://localhost:8000
# Railway: https://yourapp.up.railway.app
BASE_URL=http://localhost:8000
