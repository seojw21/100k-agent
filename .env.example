# Connect-AI 환경변수 설정 템플릿
# 이 파일을 복사하여 .env 파일을 생성하고 실제 키 값들을 입력하십시오.

# OpenAI API Key (GPT-4 / Local LLM Fallback 용)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Gemini API Key (Self-RAG 지식 업데이터용)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 텔레그램 봇 토큰 및 수신 대상 채팅방 ID
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
